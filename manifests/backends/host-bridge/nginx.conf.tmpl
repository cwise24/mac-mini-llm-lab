# Rendered by scripts/backends.sh with the resolved host IP.
upstream host_engine {
    server __HOST_IP__:__HOST_PORT__;
    keepalive 16;
}

server {
    listen 8000;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass         http://host_engine;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;

        # Streaming: never buffer SSE token deltas
        proxy_buffering    off;
        proxy_cache        off;
        chunked_transfer_encoding on;

        # Generation on a laptop-class machine can be slow; do not cut it off
        proxy_read_timeout    600s;
        proxy_send_timeout    600s;
        proxy_connect_timeout 5s;
    }
}
